# Copy to .env and adjust. Never commit .env.
MONGODB_URI=mongodb://localhost:27017/campus_booking?replicaSet=rs0
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRY_MINUTES=120
# Set to true only for local development to create demo users
SEED_DEMO_DATA=true

# Time zone for room opening hours (IANA name)
BOOKING_ZONE=Asia/Kolkata

# Optional: separate secret for check-in codes (defaults to JWT_SECRET)
# CHECKIN_SECRET=
